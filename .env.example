# API Keys (Required to enable respective provider)
ANTHROPIC_API_KEY="your_anthropic_api_key_here"       # Required: Format: sk-ant-api03-...
PERPLEXITY_API_KEY="your_perplexity_api_key_here"     # Optional: Format: pplx-...
OPENAI_API_KEY="your_openai_api_key_here"             # Optional, for OpenAI models and image generation (gerb, POST /api/images/generate). Format: sk-proj-...
# IMAGE_PROVIDER=openai                                # Optional; image generation provider: openai (default), fusion_brain, yandex_art, gigachat, alice (stubs).
# IMAGES_GENERATE_RATE_LIMIT=10                        # Optional; max requests per minute for POST /api/images/generate per deviceId or IP (default 10).
GOOGLE_API_KEY="your_google_api_key_here"             # Optional, for Google Gemini models.
MISTRAL_API_KEY="your_mistral_key_here"               # Optional, for Mistral AI models.
XAI_API_KEY="YOUR_XAI_KEY_HERE"                       # Optional, for xAI AI models.
GROQ_API_KEY="YOUR_GROQ_KEY_HERE"                     # Optional, for Groq models.
OPENROUTER_API_KEY="YOUR_OPENROUTER_KEY_HERE"         # Optional, for OpenRouter models.
AZURE_OPENAI_API_KEY="your_azure_key_here"            # Optional, for Azure OpenAI models (requires endpoint in .taskmaster/config.json).
OLLAMA_API_KEY="your_ollama_api_key_here"             # Optional: For remote Ollama servers that require authentication.
GITHUB_API_KEY="your_github_api_key_here"             # Optional: For GitHub import/export features. Format: ghp_... or github_pat_...

# ---------------------------------------------------------------------------
# Backend: Auth / JWT
# ---------------------------------------------------------------------------
# AUTH_SECRET=your_hmac_secret_for_codes         # HMAC для генерации/проверки one-time кодов
# AUTH_JWT_SECRET=your_jwt_secret_shared_with_cf_api  # JWT secret (разделяется с cf-api)
# AUTH_GENERATE_SECRET=your_secret               # Для POST /api/auth/generate-code из ЛК

# ---------------------------------------------------------------------------
# Backend: Telegram / VK webhooks & notifications
# ---------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=7857172960:AAH...           # Токен Telegram-бота
# TELEGRAM_CHANNEL_ID=-100...                    # ID канала для уведомлений
# TELEGRAM_WEBHOOK_SECRET=...                    # Секрет пути webhook /api/webhook/telegram/<secret>
# VK_API_TOKEN=vk1.a....                         # VK API токен
# VK_CONFIRMATION_CODE=...                       # VK Webhook confirmation code
# VK_WEBHOOK_SECRET=...                          # Секрет пути webhook /api/webhook/vk/<secret>

# Лимит сообщений в день для чата (GET /api/chat/limits). По умолчанию 20.
# CHAT_MESSAGES_PER_DAY=20

# ---------------------------------------------------------------------------
# P1-07: Safety filters & rate limits
# ---------------------------------------------------------------------------
# Max squad message length in characters (default 500)
# SQUAD_MSG_MAX_LEN=500
# Per-device per-minute rate limit for squad messages (default 10)
# SQUAD_MSG_RATE_LIMIT=10
# Per-device per-minute rate limit for /api/chat НейроВалюша (default 15)
# CHAT_MSG_RATE_LIMIT_PER_MIN=15
# Optional: max length of a single chat message in chars (M5-R4-C, default 2000)
# CHAT_MAX_MESSAGE_LEN=2000

# Optional: for npm run self-check to probe GET /api/health (liveness). Example: http://localhost:4000
# BACKEND_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# P1-04: Production environment gate
# ---------------------------------------------------------------------------
# Set to "production" in prod deployments to block dev-only endpoints (e.g. /api/dev/login).
# ENVIRONMENT=production

# ---------------------------------------------------------------------------
# Frontend build: Backend URLs (задаются в GitHub Secrets и Vercel frontend env)
# ---------------------------------------------------------------------------
# Backend base URL для всех API-запросов фронтенда (badge approvals, squads, shifts и т.д.)
# Vercel backend project URL (без trailing slash).
# Добавить как GitHub Secret VITE_API_URL и Vercel frontend env var VITE_API_URL.
# VITE_API_URL=https://your-backend.vercel.app

# Backend base URL для чата НейроВалюши (может совпадать с VITE_API_URL).
# Добавить как GitHub Secret VITE_BACKEND_URL и Vercel frontend env var VITE_BACKEND_URL.
# VITE_BACKEND_URL=https://your-backend.vercel.app

# ---------------------------------------------------------------------------
# Supabase (Storage Provider) — P1-01/P1-02/P1-03
# ---------------------------------------------------------------------------
# USE_SUPABASE=false               # Set to true in staging/prod to use Supabase instead of JSON files
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...  # Service Role key (NOT anon key) — backend only, never send to client