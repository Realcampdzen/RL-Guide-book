{
  "name": "rl-guide-book",
  "version": "1.0.0",
  "description": "Космическая визуализация Путеводителя 'Реального Лагеря'",
  "main": "index.js",
  "scripts": {
    "dev": "vite --host --port 3001",
    "dev:staging": "vite --host --port 3002",
    "dev:profile-desktop": "vite --host --port 3010",
    "dev:html": "node server-html.js",
    "verify:webp": "node scripts/verify-webp-siblings.mjs",
    "build": "npm run verify:webp && tsc && vite build",
    "build:verify": "npm run build && node scripts/verify-images-build.mjs",
    "preview": "vite preview --host --port 3001 --base /RL-Guide-book/",
    "preview:prod": "node server-preview.js",
    "vercel-build": "npm run build",
    "start:api": "node api/index.js",
    "start:chatbot": "cd chatbot && python main.py",
    "start:backend": "cd backend && python app.py",
    "render-build": "npm run build",
    "verify-images": "node scripts/verify-images-build.mjs",
    "verify-image-names": "node scripts/normalize-badge-images.mjs --check",
    "normalize-images": "node scripts/normalize-badge-images.mjs --apply",
    "normalize:badge-icons:check": "node scripts/normalize-badge-icons.mjs --check",
    "normalize:badge-icons:apply": "node scripts/normalize-badge-icons.mjs --apply",
    "images:webp": "node scripts/generate-webp.mjs",
    "self-check": "node scripts/self-check.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:profile-mobile": "playwright test e2e/profile.mobile.smoke.spec.ts",
    "check:prompts-constants": "node scripts/check-prompts-constants-sync.mjs",
    "sync:ai-data": "node scripts/sync-ai-data.mjs",
    "sync:cf-api-ai-data": "node scripts/sync-cf-api-ai-data.mjs",
    "sync:cf-api-prompts": "node scripts/sync-cf-api-prompts.mjs",
    "analyze": "vite build --mode analyze"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "agentation-mcp": "^1.1.1",
    "fitty": "^2.4.2",
    "openai": "^4.0.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.3.3",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "adm-zip": "^0.5.16",
    "rollup-plugin-visualizer": "^6.0.3",
    "sharp": "^0.34.5",
    "typescript": "^5.0.2",
    "vite": "^4.4.5"
  },
  "keywords": [
    "react",
    "three.js",
    "cosmic",
    "visualization",
    "badges",
    "camp"
  ],
  "author": "Путеводитель Web Team",
  "license": "MIT"
}
