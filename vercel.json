{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/proxy-api/(.*)",
      "dest": "https://backend-murex-one-40.vercel.app/$1"
    },
    {
      "src": "/proxy-supabase/(.*)",
      "dest": "https://inkhtjcrzblzsfqvceid.supabase.co/$1"
    },
    {
      "src": "/RL-Guide-book/(.*)",
      "dest": "/$1",
      "continue": true
    },
    { "handle": "filesystem" },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
