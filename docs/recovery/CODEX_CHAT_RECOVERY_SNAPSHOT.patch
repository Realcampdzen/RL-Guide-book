+
+    meta = (doc.get("codes") or {}).get(code)
+    if not isinstance(meta, dict):
+        return jsonify({"error": "Invite code not found"}), 404
+    squad_id = (meta.get("squadId") or "").strip()
+    if not squad_id:
+        return jsonify({"error": "Invite code invalid"}), 400
