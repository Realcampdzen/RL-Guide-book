{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "flask_entry.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/chat",
      "dest": "/api/index.js"
    },
    {
      "src": "/api/stats",
      "dest": "/api/index.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/flask_entry.py"
    }
  ]
}
